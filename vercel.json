{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "redirects": [
    {
      "source": "/planos",
      "destination": "/pricing",
      "permanent": true
    },
    {
      "source": "/planos/",
      "destination": "/pricing",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/(pricing|terms|privacy|refunds|signup|login)(/?)",
      "destination": "/$1/index.html"
    },
    {
      "source": "/(app|create|brand|builder|quick|optimizer|versions|tester|settings|checkout|purchase-success|subscription-success|account|admin|unsubscribe)(/?)",
      "destination": "/spa.html"
    },
    {
      "source": "/(library|learn|packs)(/.*)?",
      "destination": "/spa.html"
    }
  ],
  "headers": [
    {
      "source": "/sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        },
        {
          "key": "Service-Worker-Allowed",
          "value": "/"
        }
      ]
    },
    {
      "source": "/version.json",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        }
      ]
    },
    {
      "source": "/index.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        }
      ]
    },
    {
      "source": "/",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        }
      ]
    },
    {
      "source": "/((?!assets/).*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' 'sha256-ufeSWdhxeNC2We+QvUnFZTFeC5djXQa5Ea3o66xEgwM=' 'sha256-S3JRY2qapqfFPCFHHJAiAncnHRrJ6ojioMqTvBjHzk8=' 'sha256-OQ4dUOgS2SltbWv++IqfZzgyND/2AUm6EDBQr+wcEhA=' https://cdn.paddle.com https://*.profitwell.com https://eu-assets.i.posthog.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://cdn.paddle.com https://*.profitwell.com; font-src 'self' data: https://fonts.gstatic.com; img-src 'self' data: blob: https://cwrxbxxfaemcvliasycz.supabase.co https://*.paddle.com https://eu.i.posthog.com https://eu-assets.i.posthog.com https://*.profitwell.com; connect-src 'self' https://cwrxbxxfaemcvliasycz.supabase.co wss://cwrxbxxfaemcvliasycz.supabase.co https://eu.i.posthog.com https://eu-assets.i.posthog.com https://*.paddle.com https://*.profitwell.com; frame-src https://buy.paddle.com https://sandbox-buy.paddle.com https://*.profitwell.com; worker-src 'self' blob:; manifest-src 'self'; media-src 'self' blob:; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; upgrade-insecure-requests"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), geolocation=(), microphone=(self), usb=(), browsing-topics=()"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000"
        }
      ]
    }
  ]
}
